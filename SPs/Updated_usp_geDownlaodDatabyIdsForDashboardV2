/* =============================================
-- Description: Download data for dashboard based on ids returned by
--              usp_getProjectScopeDetailsForDashboardV2.
--
-- Optimized version:
--   The id filters are now passed into usp_downloadDeliverableByScopeIdV2,
--   which builds only the required rows. The old post-filter (WHERE EXISTS ...)
--   and the unused tblProjectScope join are removed.
--
-- Requires: the optimized usp_downloadDeliverableByScopeIdV2 (with the three
--           new optional filter parameters) to be deployed first.
--
 EXEC dbo.usp_geDownlaodDatabyIdsForDashboardV2
     @ProjectScopeIds = '304051,304051,304051,304051,414199,414201,414199,414201,414201,414209,414215,414215',
     @ProjectDeliverableIds = '507753,507744,771409,771494,771410,771406,771463,771520,771518',
     @ParentProjectDeliverableIds = '771404,771406,771519',
     @ProjectDeliverableTaskIds = '583777,532814,583902,532822,663478,663568,663562,663489,663479,663516,663583,663581',
     @loggedInUserId = 1030;
-- =============================================
*/
CREATE OR ALTER PROCEDURE dbo.usp_geDownlaodDatabyIdsForDashboardV2
(
    @ProjectScopeIds             NVARCHAR(MAX) = NULL,
    @ProjectDeliverableIds       NVARCHAR(MAX) = NULL,
    @ParentProjectDeliverableIds NVARCHAR(MAX) = NULL,
    @ProjectDeliverableTaskIds   NVARCHAR(MAX) = NULL,
    @loggedInUserId              INT,
    @languageCode                VARCHAR(5) = 'en',
    @getDate                     DATETIME = NULL
)
AS
BEGIN
    SET NOCOUNT ON;

    DROP TABLE IF EXISTS #DownloadData;

    /*
        This table must exactly match the columns returned by
        dbo.usp_downloadDeliverableByScopeIdV2.
    */
    CREATE TABLE #DownloadData
    (
        recordTypeShortName        VARCHAR(10),
        recordType                 VARCHAR(100),
        projectScopeId             INT,
        parentProjectDeliverableId INT,
        projectDeliverableId       INT,
        projectDeliverableTaskId   INT,
        parentId                   INT,
        displayNo                  VARCHAR(100),
        name                       NVARCHAR(MAX),
        ownerName                  NVARCHAR(255),
        statusName                 NVARCHAR(255),
        statusDate                 DATETIME,
        reason                     NVARCHAR(MAX),
        StartDate                  DATETIME,
        plannedDate                DATETIME,
        committedDate              DATETIME,
        enggEstHrs                 DECIMAL(18, 2),
        orgEstHrs                  DECIMAL(18, 2),
        costCodeName               NVARCHAR(MAX),
        costCodePercentage         DECIMAL(18, 2),
        enggTeamName               NVARCHAR(255),
        isRevision                 BIT,
        remainingHours             DECIMAL(18, 2),
        timesheetHours             DECIMAL(18, 2),
        keyIdentifier              INT
    );

    /*
        Guard: if no ids at all were supplied, the download SP would treat the
        call as "no filter" and return EVERYTHING for the scopes. For the
        dashboard we never want that, so return an empty result instead.
        Remove this block if you do want the full scope download in that case.
    */
    IF  NULLIF(LTRIM(RTRIM(@ProjectDeliverableIds)), '')       IS NULL
    AND NULLIF(LTRIM(RTRIM(@ParentProjectDeliverableIds)), '') IS NULL
    AND NULLIF(LTRIM(RTRIM(@ProjectDeliverableTaskIds)), '')   IS NULL
    BEGIN
        SELECT
            recordTypeShortName, recordType, projectScopeId, parentProjectDeliverableId,
            projectDeliverableId, projectDeliverableTaskId, parentId, displayNo, name,
            ownerName, statusName, statusDate, reason, StartDate, plannedDate,
            committedDate, enggEstHrs, orgEstHrs, costCodeName, costCodePercentage,
            enggTeamName, isRevision, remainingHours, timesheetHours, keyIdentifier
        FROM #DownloadData;   -- empty

        DROP TABLE IF EXISTS #DownloadData;
        RETURN;
    END;

    INSERT INTO #DownloadData
    (
        recordTypeShortName, recordType, projectScopeId, parentProjectDeliverableId,
        projectDeliverableId, projectDeliverableTaskId, parentId, displayNo, name,
        ownerName, statusName, statusDate, reason, StartDate, plannedDate,
        committedDate, enggEstHrs, orgEstHrs, costCodeName, costCodePercentage,
        enggTeamName, isRevision, remainingHours, timesheetHours, keyIdentifier
    )
    EXEC dbo.usp_downloadDeliverableByScopeIdV2
        @projectScopeId              = @ProjectScopeIds,
        @loggedInUserId              = @loggedInUserId,
        @languageCode                = @languageCode,
        @getDate                     = @getDate,
        @projectDeliverableIds       = NULLIF(LTRIM(RTRIM(@ProjectDeliverableIds)), ''),
        @parentProjectDeliverableIds = NULLIF(LTRIM(RTRIM(@ParentProjectDeliverableIds)), ''),
        @projectDeliverableTaskIds   = NULLIF(LTRIM(RTRIM(@ProjectDeliverableTaskIds)), '');

    SELECT
        d.recordTypeShortName,
        d.recordType,
        d.projectScopeId,
        d.parentProjectDeliverableId,
        d.projectDeliverableId,
        d.projectDeliverableTaskId,
        d.parentId,
        d.displayNo,
        d.name,
        d.ownerName,
        d.statusName,
        d.statusDate,
        d.reason,
        d.StartDate,
        d.plannedDate,
        d.committedDate,
        d.enggEstHrs,
        d.orgEstHrs,
        d.costCodeName,
        d.costCodePercentage,
        d.enggTeamName,
        d.isRevision,
        d.remainingHours,
        d.timesheetHours,
        d.keyIdentifier
    FROM #DownloadData AS d
    ORDER BY d.projectScopeId;

    DROP TABLE IF EXISTS #DownloadData;
END;
